{
  "name": "copytrade",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "next lint",
    "reset": "tsx scripts/reset-all.ts",
    "reset:db": "tsx scripts/reset-all.ts --skip-exchange",
    "reset:exchange": "tsx scripts/reset-all.ts --skip-db",
    "reset:dry": "tsx scripts/reset-all.ts --dry-run",
    "reset:funds": "tsx scripts/reset-all.ts --reset-funds-only",
    "reset:all": "tsx scripts/reset-all.ts --reset-funds",
    "prebuild": "npm --prefix ../shared run build",
    "predev": "npm --prefix ../shared run build",
    "prelint": "npm --prefix ../shared run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/generative-ai": "^0.24.1",
