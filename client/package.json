    "crypto-js": "^4.2.0",
    "discord.js": "^14.16.3",
    "https-proxy-agent": "^9.0.0",
    "mongoose": "^8.9.5",
    "next": "^16.2.1",
    "openai": "^4.77.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "@copytrade/shared": "file:../shared"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
