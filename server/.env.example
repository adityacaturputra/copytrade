# ─── Server Configuration ──────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── AI Provider Selection ─────────────────────────────────
# Options: glm | kimi | openai | codex | patungin
AI_PROVIDER=glm

# ─── GLM (ZhipuAI) Configuration ───────────────────────────
GLM_API_KEY=your_glm_api_key_here
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
GLM_MODEL=glm-5.1

# ─── Kimi (Anthropic-compatible) Configuration ─────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=kimi-latest

# ─── OpenAI Configuration ──────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ─── CodexPatungin Configuration (OpenAI-compatible) ──────
# If omitted, the app also attempts to read ~/.codex/config.toml
# (model_provider=patungin, base_url, experimental_bearer_token).
PATUNGIN_API_KEY=your_patungin_api_key_here
PATUNGIN_BASE_URL=https://ai.patungin.id/v1
PATUNGIN_MODEL=gpt-5.3-codex
# Optional: separate model for image pre-layer when VISION_AI_PROVIDER=patungin
# PATUNGIN_VISION_MODEL=gpt-5.3-codex

# ─── Gemini Vision AI (Image Pre-Layer) ────────────────────
GEMINI_VISION_API_KEY=your_gemini_api_key_here
# Vision provider options: gemini | codex | patungin
# If omitted, it auto-follows AI_PROVIDER when using codex/patungin.
# VISION_AI_PROVIDER=gemini
# GEMINI_VISION_MODEL=gemini-2.5-flash-preview-05-20

# ─── Proxy Configuration ───────────────────────────────────
WEBSHARE_API_KEY=your_webshare_api_key_here

# ─── MongoDB ───────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/copytrade

# ─── Cron Security ─────────────────────────────────────────
CRON_SECRET=your_random_secret_here

# ─── Cron-Job.org Integration ──────────────────────────────
CRON_JOB_API_KEY=your_cron_job_api_key_here

# ─── Frontend URL (for CORS) ───────────────────────────────
FRONTEND_URL=https://your-vercel-app.vercel.app
