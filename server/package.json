{
  "name": "copytrade-backend",
  "version": "1.0.0",
  "description": "CopyTrade backend API for long-running cron jobs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.build.json --noEmit",
    "prebuild": "yarn --cwd ../shared build",
    "predev": "yarn --cwd ../shared build",
    "prelint": "yarn --cwd ../shared build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "https-proxy-agent": "^9.0.0",
    "mongoose": "^8.9.5",
    "openai": "^4.77.0",
    "@copytrade/shared": "file:../shared"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
