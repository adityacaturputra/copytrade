# ─── Shared Environment (Root Monorepo .env) ────────────────────────────────
# This single file is used by both:
# - client (Next.js frontend)
# - server (Express backend)
#
# Copy this file to /.env and fill values:
#   cp .env.example .env

# ─── Server Configuration ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Backend/Frontend URLs ───────────────────────────────────────────────────
# Backend URL used by frontend route handlers
BACKEND_URL=http://localhost:3001
# Public backend URL used by browser-side frontend calls (agent chat)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
# Frontend URL used by backend CORS allow-list
FRONTEND_URL=http://localhost:3000
# Used by backend agent tools when they need to call frontend-only APIs
# (draft accept/reject endpoints)
# FRONTEND_URL already covers this in most cases.

# ─── AI Provider Selection ───────────────────────────────────────────────────
# Options: glm | kimi | openai | codex | patungin | konektika
AI_PROVIDER=glm
# Fallback providers when the primary fails (comma-separated).
# Each provider's API keys also support comma-separated fallback keys.
# Example: patungin,konektika,glm,kimi
# AI_PROVIDER_FALLBACK=patungin,konektika,glm,kimi

# ─── GLM (ZhipuAI) Configuration ─────────────────────────────────────────────
GLM_API_KEY=your_glm_api_key_here
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
GLM_MODEL=glm-5.1

# ─── Kimi (Anthropic-compatible) Configuration ───────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=kimi-latest

# ─── OpenAI Configuration ────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ─── Test / Live E2E Flags ───────────────────────────────────────────────────
# Keep disabled by default. When enabled, the live suite will use dev-only env
# credentials that already exist in this file/.env.
ENABLE_LIVE_INTEGRATION_TESTS=false
ENABLE_LIVE_EXCHANGE_TESTS=false

# ─── CodexPatungin Configuration (OpenAI-compatible) ────────────────────────
# If omitted, the app also attempts to read ~/.codex/config.toml
# (model_provider=patungin, base_url, experimental_bearer_token).
PATUNGIN_API_KEY=your_patungin_api_key_here
PATUNGIN_BASE_URL=https://ai.patungin.id/v1
PATUNGIN_MODEL=gpt-5.3-codex
# Optional provider-specific headers (useful if requests are blocked)
# PATUNGIN_HTTP_REFERER=https://your-app.example
# PATUNGIN_X_TITLE=CopyTrade
# PATUNGIN_ORIGIN=https://your-app.example
# PATUNGIN_USER_AGENT=copytrade-bot/1.0
# JSON or line-based map. Example:
# PATUNGIN_EXTRA_HEADERS={"X-Your-Header":"value"}
# Optional: separate model for image pre-layer when VISION_AI_PROVIDER=patungin
# PATUNGIN_VISION_MODEL=gpt-5.3-codex

# ─── Gemini Vision AI (Image Pre-Layer) ─────────────────────────────────────
# Uses Gemini 2.5 Flash to read trading chart images and extract
# price levels (Entry, TP, SL) before the main AI processes the signal.
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_VISION_API_KEY=your_gemini_api_key_here
# Vision provider options: gemini | codex | patungin | glm | kimi
# If omitted, it auto-follows AI_PROVIDER when using codex/patungin/glm/kimi.
# VISION_AI_PROVIDER=gemini
# Fallback vision providers when the primary fails (comma-separated).
# Example: patungin,glm,kimi,gemini
# VISION_AI_PROVIDER_FALLBACK=patungin,konektika,glm,kimi,gemini
# Model to use (default: gemini-2.5-flash-preview-05-20)
# GEMINI_VISION_MODEL=gemini-2.5-flash-preview-05-20
# Optional: separate model for GLM vision (defaults to GLM_MODEL)
# GLM_VISION_MODEL=glm-5.1
# Optional: separate model for Kimi vision (defaults to ANTHROPIC_MODEL)
# ANTHROPIC_VISION_MODEL=kimi-latest

# ─── Konektika Configuration ──────────────────────────────────────────────────
# KONEKTIKA_API_KEY=your_konektika_api_key
# KONEKTIKA_BASE_URL=https://konektikacloud.web.id/v1
# KONEKTIKA_MODEL=konektika-pro
# Optional: separate model for Konektika vision (defaults to KONEKTIKA_MODEL)
# KONEKTIKA_VISION_MODEL=konektika-pro

# ─── Proxy Configuration (Static IP for API Whitelisting) ───────────────────
# Webshare.io proxy for OKX static IP whitelisting.
# Get your API key from: https://www.webshare.io → Dashboard → API
WEBSHARE_API_KEY=your_webshare_api_key_here

# Legacy: If you have a custom proxy server (e.g., on Oracle Cloud VPS),
# set these to route exchange API calls through the proxy.
# See client/proxy/README.md for setup instructions.
# OKX_PROXY_URL=http://your-vps-ip:3000/okx
# MEXC_PROXY_URL=http://your-vps-ip:3000/mexc

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/copytrade

# ─── Cron Security (optional) ────────────────────────────────────────────────
CRON_SECRET=your_random_secret_here

# ─── Cron-Job.org Integration (optional) ─────────────────────────────────────
# Used to auto-configure cron jobs from the settings UI
CRON_JOB_API_KEY=your_cron_job_api_key_here

# ─── Action Password (UI unlock for mutations) ───────────────────────────────
# Password required to unlock destructive/mutating actions in the UI.
# If not set, all actions are allowed without password (development mode).
# Stored in browser localStorage; can be cleared from the UI.
ACTION_PASSWORD=
