# ─── Discord Configuration ──────────────────────────────────
# NOTE: You can now configure multiple Discord sources via the Settings UI (/settings).
# The env vars below are used as a fallback when no DB sources are configured.

# Option A: Bot token (requires adding bot to server)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Option B: User account token (no bot invite needed, but against ToS)
# Set DISCORD_USER_TOKEN to use your personal account via REST API
DISCORD_USER_TOKEN=

# Channel ID to monitor for signals (env fallback only)
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# ─── AI Provider Selection ─────────────────────────────────
# Options: glm | kimi | openai
AI_PROVIDER=glm

# ─── GLM (ZhipuAI) Configuration ───────────────────────────
GLM_API_KEY=your_glm_api_key_here
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
GLM_MODEL=glm-5.1

# ─── Kimi (Anthropic-compatible) Configuration ─────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=kimi-latest

# ─── OpenAI Configuration ──────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ─── Exchange Selection ───────────────────────────────────
# Options: mexc | okx | paper
# Use "paper" for testing without real API keys (simulated trading with $10,000 virtual balance)
EXCHANGE_PROVIDER=paper

# ─── MEXC API Configuration ────────────────────────────────
# Get keys from: mexc.com → Profile → API Management
# Only needed when EXCHANGE_PROVIDER=mexc
MEXC_API_KEY=your_mexc_api_key_here
MEXC_SECRET_KEY=your_mexc_secret_key_here

# ─── OKX API Configuration ────────────────────────────────
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET_KEY=your_okx_secret_key_here
OKX_PASSPHRASE=your_okx_passphrase_here
OKX_SIMULATED=false
# OKX_BASE_URL=https://www.okx.com  # Uncomment if okx.com is blocked by ISP (e.g. use https://aws.okx.com)

# ─── Proxy Configuration (Static IP for API Whitelisting) ──
# Webshare.io proxy for OKX static IP whitelisting.
# Get your API key from: https://www.webshare.io → Dashboard → API
WEBSHARE_API_KEY=your_webshare_api_key_here

# Legacy: If you have a custom proxy server (e.g., on Oracle Cloud VPS),
# set these to route exchange API calls through the proxy.
# See proxy/README.md for setup instructions.
# OKX_PROXY_URL=http://your-vps-ip:3000/okx
# MEXC_PROXY_URL=http://your-vps-ip:3000/mexc

# ─── MongoDB ───────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/copytrade

# ─── Cron Security (optional) ──────────────────────────────
CRON_SECRET=your_random_secret_here

# ─── Trading Settings ──────────────────────────────────────
DEFAULT_POSITION_SIZE=50
DEFAULT_LEVERAGE=10
MAX_POSITIONS=5
RISK_PER_TRADE_PERCENT=2