# ─── Proxy Configuration ─────────────────────────────────
# Port to listen on
PORT=3000

# Target exchange URLs (change if using alternate endpoints)
OKX_TARGET=https://www.okx.com
MEXC_TARGET=https://contract.mexc.com

# Security: API secret for authenticating requests from Vercel
# If set, all requests must include this secret via:
#   - Query param: ?secret=your_secret_here
#   - Header: x-proxy-secret: your_secret_here
API_SECRET=

# Security: Comma-separated list of allowed client IPs
# If set, only these IPs can connect to the proxy
# Example: ALLOWED_IPS=76.76.21.21,76.76.21.22
ALLOWED_IPS=
