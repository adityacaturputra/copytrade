{
  "name": "@copytrade/shared",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "require": "./dist/lib/*.js",
      "import": "./dist/lib/*.js",
      "default": "./dist/lib/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.7.9",
    "crypto-js": "^4.2.0",
    "discord.js": "^14.16.3",
    "https-proxy-agent": "^9.0.0",
    "mongoose": "^8.9.5",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
